# Local testing only. In GitHub, add these as Actions secrets/variables instead (see README). Never commit a real .env.

# --- Image generation: IMAGE_PROVIDER = cloudflare (default) or openai
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Only if IMAGE_PROVIDER=openai
OPENAI_API_KEY=

# --- Captions (optional; the default template and Cloudflare captions work without it)
ANTHROPIC_API_KEY=

# --- Instagram API with Instagram Login (no Facebook Page needed)
# Long-lived token for @fdc.dental; refreshed automatically each week by the workflow
IG_ACCESS_TOKEN=

# --- Image hosting: github (default; commits images/ into this PUBLIC repo) or imgbb
IMAGE_HOST=github
# Only if IMAGE_HOST=imgbb
IMGBB_API_KEY=

# --- Approval email (sent through your own mail provider's SMTP server)
SMTP_HOST=smtp.livemail.co.uk
SMTP_PORT=587            # 587 = STARTTLS, 465 = SSL
SMTP_USER=               # full mailbox address used to log in and send
SMTP_PASSWORD=
MAIL_FROM=               # optional; defaults to SMTP_USER
APPROVER_EMAIL=          # who receives the weekly draft

# --- Approval links: must match the Worker's settings in Cloudflare
APPROVAL_BASE_URL=https://fdc-approvals.YOUR-SUBDOMAIN.workers.dev
LINK_SECRET=             # long random string, same value in GitHub and in the Worker

# --- Optional overrides
# THEME_ID=whitening-intro
# IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b   (or gpt-image-1 for openai)
# CAPTION_MODEL=claude-sonnet-5-5
# CAPTION_CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# GRAPH_VERSION=v25.0
