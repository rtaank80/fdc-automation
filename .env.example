# Local testing only. In GitHub, add these as Actions secrets instead. Never commit a real .env.

# Caption writing (optional; a safe template is used if missing)
ANTHROPIC_API_KEY=

# Image generation: IMAGE_PROVIDER = cloudflare (default) or openai
IMAGE_PROVIDER=cloudflare
# Cloudflare Workers AI (FLUX.2 klein 9B)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Only if IMAGE_PROVIDER=openai
OPENAI_API_KEY=

# Instagram API with Instagram Login (no Facebook Page needed)
# Long-lived token for @fdc.dental; refreshed automatically each week by the workflow
IG_ACCESS_TOKEN=
# Optional; defaults to "me" (the account that owns the token)
# IG_USER_ID=

# Image hosting: github (default; commits images/ into this PUBLIC repo, no extra key needed) or imgbb
IMAGE_HOST=github
# Only if IMAGE_HOST=imgbb
IMGBB_API_KEY=

# Optional overrides
# THEME_ID=whitening-intro
# IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b   (or gpt-image-1 for openai)
# CAPTION_MODEL=claude-sonnet-5-5
# CAPTION_CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CAPTION_CHOICE=2   (local runs only: force option 1, 2 or 3)
# GRAPH_VERSION=v25.0
